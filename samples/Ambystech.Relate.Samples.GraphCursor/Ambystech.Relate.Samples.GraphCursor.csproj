<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Ambystech.Relate.Samples.GraphCursor</RootNamespace>
    <!-- Sample code: warnings are errors, but the strictest library analyzers are relaxed. -->
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <!-- CA1515: public types in an exe (tests and DI use them). CA1822: GraphReader is an instance on purpose, one per CursorOptions. -->
    <NoWarn>$(NoWarn);CA1515;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ambystech.Relate.csproj" />
    <EmbeddedResource Include="Seed\org.cypher" LogicalName="org.cypher" />
    <InternalsVisibleTo Include="Ambystech.Relate.Samples.GraphCursor.Tests" />
  </ItemGroup>

  <!-- Natives under runtimes/<rid>/native, staged by scripts/fetch-natives.sh (or set RELATE_LIB). -->
  <ItemGroup>
    <None Include="$(RelateNativesDir)\**\*.so;$(RelateNativesDir)\**\*.dylib;$(RelateNativesDir)\**\*.dll"
          Link="runtimes\%(RecursiveDir)native\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
